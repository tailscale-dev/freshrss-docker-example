# FreshRSS — Option A (reachable on LAN and over the tailnet, by port)

ADMIN_EMAIL=you@example.net

# Change BOTH of these passwords. ADMIN_API_PASSWORD is what third-party apps use to authenticate.
ADMIN_PASSWORD=change-me-to-something-strong
ADMIN_API_PASSWORD=change-me-to-something-different

# BASE_URL / SERVER_DNS intentionally left EMPTY.
# This setup answers at more than one address (its LAN IP and its Tailscale
# IP/name); pinning one canonical URL would 301-redirect the others. Leaving
# these blank lets FreshRSS use whatever address each request came in on.
# BASE_URL=
# SERVER_DNS=

# --- Database: ignore all of this on the default SQLite setup ---
DB_HOST=freshrss-db
DB_BASE=freshrss
DB_USER=freshrss
DB_PASSWORD=freshrss